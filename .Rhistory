rows <- all_stats[all_stats$gene_id == gid, ]
if ("descriptions" %in% colnames(rows) &&
!is.na(rows$descriptions[1]) && rows$descriptions[1] != "") {
return(as.character(rows$descriptions[1]))
}
return(gid)
}
gene_names <- setNames(sapply(top5_genes, get_gene_name), top5_genes)
# =============================================================================
# COLORS
# =============================================================================
geno_colors    <- colorRamp2(c(0, 1, 2), c("#92C5DE", "#F7F7F7", "#F4A582"))
outlier_colors <- c("Y" = "#E65100", "N" = "#F0F0F0")
effect_colors <- c(
"syn"               = "#4575B4",
"mis"               = "#D73027",
"splice+syn"        = "#00CD6C",
"mis+splice"        = "#FFC61E",
"stop_gain"         = "#AF58BA",
"stop_loss"         = "#F28522",
"start_loss"        = "#00C2C7",
"start_ret"         = "#FF6F91",
"stop_ret"          = "#845EC2",
"stop_gain+splice"  = "#D65DB1",
"stop_loss+splice"  = "#008B74",
"start_loss+splice" = "#B0A8B9",
"intron"            = "#A0B1BA",
"other"             = "white"
)
# =============================================================================
# EFFECT CLASSIFICATION
# =============================================================================
effect_lookup <- c(
"synonymous_variant"                        = "syn",
"missense_variant"                          = "mis",
"splice_region_variant&synonymous_variant"  = "splice+syn",
"missense_variant&splice_region_variant"    = "mis+splice",
"stop_gained"                               = "stop_gain",
"stop_lost"                                 = "stop_loss",
"start_lost"                                = "start_loss",
"start_retained_variant"                    = "start_ret",
"stop_retained_variant"                     = "stop_ret",
"stop_gained&splice_region_variant"         = "stop_gain+splice",
"stop_lost&splice_region_variant"           = "stop_loss+splice",
"start_lost&splice_region_variant"          = "start_loss+splice",
"intron_variant"                            = "intron"
)
classify_effect <- function(e) {
e <- as.character(e)
if (is.na(e) || e == "") return("other")
if (e == "5_prime_UTR_premature_start_codon_gain_variant") return("other")
if (e %in% names(effect_lookup)) return(effect_lookup[[e]])
return("other")
}
make_yn <- function(x) {
x <- as.character(x)
ifelse(x %in% c("TRUE", "Y", "Yes", "yes", "true"), "Y", "N")
}
# =============================================================================
# MAIN LOOP — one heatmap per gene
# =============================================================================
for (gene_id in top5_genes) {
cat("\n=== Processing", gene_id, "===\n")
# subset stats table to this gene
stats <- all_stats[all_stats$gene_id == gene_id, ]
cat("  SNPs in stats table:", nrow(stats), "\n")
# get Affx IDs for this gene
affx_ids <- stats$Affx_ID
# find which Affx IDs are columns in the geno matrix
# (check.names=FALSE means dashes are preserved)
snp_cols <- affx_ids[affx_ids %in% colnames(all_geno)]
cat("  SNPs found in geno matrix:", length(snp_cols), "/", length(affx_ids), "\n")
if (length(snp_cols) == 0) {
cat("  Skipping - no SNPs found in geno matrix\n")
next
}
# pull out just this gene's SNP columns + metadata columns
meta_cols <- c("clean_ID", "Pop_ID", "Mean_Annual_Temperature_C",
"Mean_Annual_Salinity_ppt")
geno <- all_geno[, c(meta_cols, snp_cols), drop = FALSE]
# -------------------------------------------------------------------------
# PREPARE GENOTYPE MATRIX
# -------------------------------------------------------------------------
# drop rows with missing metadata
geno <- geno[complete.cases(geno[, meta_cols]), ]
# order by Pop_ID (Gulf 1-13 on top, Atlantic 14-40 on bottom)
geno <- geno[order(geno$Pop_ID), ]
geno_mat <- as.matrix(geno[, snp_cols, drop = FALSE])
rownames(geno_mat) <- geno$clean_ID
n_gulf <- sum(geno$Pop_ID <= 13)
n_atl  <- sum(geno$Pop_ID >= 14)
cat("  Individuals:", nrow(geno), "(Gulf:", n_gulf, "| Atlantic:", n_atl, ")\n")
# -------------------------------------------------------------------------
# COLUMN LABELS — Affx ID (REF/ALT)
# -------------------------------------------------------------------------
stats_ordered <- stats[match(snp_cols, stats$Affx_ID), ]
col_labels    <- paste0(stats_ordered$Affx_ID, " (",
stats_ordered$REF, "/", stats_ordered$ALT, ")")
# -------------------------------------------------------------------------
# TOP ANNOTATIONS
# -------------------------------------------------------------------------
eff        <- sapply(stats_ordered$Effect, classify_effect)
eff_levels <- unique(eff)
eff_cols   <- effect_colors[eff_levels]
cat("  Effect types:", paste(names(table(eff)), collapse = ", "), "\n")
fst <- pmax(pmin(replace(stats_ordered$FST, is.na(stats_ordered$FST), 0), 1), 0)
outlier_col_names <- c("outflank_outlier", "pcadapt_outlier_qval",
"lfmm_global_hightemp_outlier", "lfmm_global_lowtemp_outlier",
"lfmm_atlantic_highsal_outlier", "lfmm_atlantic_lowsal_outlier",
"lfmm_gulf_highsal_outlier", "lfmm_gulf_lowsal_outlier")
outlier_display <- c("outflank", "pcadapt",
"lfmm_hitemp", "lfmm_lotemp",
"lfmm_atl_hisal", "lfmm_atl_losal",
"lfmm_gulf_hisal", "lfmm_gulf_losal")
outlier_list <- list()
for (i in seq_along(outlier_col_names)) {
col <- outlier_col_names[i]
outlier_list[[outlier_display[i]]] <- if (col %in% colnames(stats_ordered)) {
make_yn(stats_ordered[[col]])
} else {
rep("N", nrow(stats_ordered))
}
}
top_anno <- HeatmapAnnotation(
outflank        = outlier_list[["outflank"]],
pcadapt         = outlier_list[["pcadapt"]],
lfmm_hitemp     = outlier_list[["lfmm_hitemp"]],
lfmm_lotemp     = outlier_list[["lfmm_lotemp"]],
lfmm_atl_hisal  = outlier_list[["lfmm_atl_hisal"]],
lfmm_atl_losal  = outlier_list[["lfmm_atl_losal"]],
lfmm_gulf_hisal = outlier_list[["lfmm_gulf_hisal"]],
lfmm_gulf_losal = outlier_list[["lfmm_gulf_losal"]],
FST    = fst,
Effect = eff,
col = list(
outflank        = outlier_colors,
pcadapt         = outlier_colors,
lfmm_hitemp     = outlier_colors,
lfmm_lotemp     = outlier_colors,
lfmm_atl_hisal  = outlier_colors,
lfmm_atl_losal  = outlier_colors,
lfmm_gulf_hisal = outlier_colors,
lfmm_gulf_losal = outlier_colors,
FST    = colorRamp2(c(0, 0.5, 1), c("#F7FCF5", "#74C476", "#00441B")),
Effect = eff_cols
),
show_legend = c(TRUE, FALSE, FALSE, FALSE,
FALSE, FALSE, FALSE, FALSE,
TRUE, TRUE),
annotation_name_gp = gpar(fontsize = 9),
gap = unit(1, "mm")
)
# -------------------------------------------------------------------------
# LEFT ANNOTATIONS
# -------------------------------------------------------------------------
temp_range <- range(geno$Mean_Annual_Temperature_C, na.rm = TRUE)
sal_range  <- range(geno$Mean_Annual_Salinity_ppt,  na.rm = TRUE)
left_anno <- rowAnnotation(
Pop_ID = geno$Pop_ID,
Temp   = geno$Mean_Annual_Temperature_C,
Sal    = geno$Mean_Annual_Salinity_ppt,
col = list(
Pop_ID = colorRamp2(c(1, 20, 40),           c("#FDE725", "#21918C", "#440154")),
Temp   = colorRamp2(c(temp_range[1],
mean(temp_range),
temp_range[2]),         c("#2166AC", "#F7F7F7", "#B2182B")),
Sal    = colorRamp2(sal_range,               c("#E0F7FA", "#00695C"))
),
width = unit(c(0.6, 0.6, 0.6), "cm"),
annotation_name_gp = gpar(fontsize = 9),
annotation_legend_param = list(
Pop_ID = list(title = "Pop ID"),
Temp   = list(title = "Temp (C)"),
Sal    = list(title = "Sal (ppt)")
)
)
# -------------------------------------------------------------------------
# DRAW HEATMAP
# -------------------------------------------------------------------------
pop_group <- factor(ifelse(geno$Pop_ID <= 13, "Gulf", "Atlantic"),
levels = c("Gulf", "Atlantic"))
ht <- Heatmap(
geno_mat,
name = "Genotype",
col  = geno_colors,
heatmap_legend_param = list(
at = c(0, 1, 2), labels = c("Ref", "Het", "Alt")
),
cluster_rows    = FALSE,
cluster_columns = TRUE,   # let SNPs cluster naturally (Katie's request)
row_split       = pop_group,
row_gap         = unit(2, "mm"),
row_title_gp    = gpar(fontsize = 11, fontface = "bold"),
column_labels   = col_labels,
column_names_rot = 90,
column_names_gp = gpar(fontsize = col_fontsize),
show_row_names  = FALSE,
top_annotation  = top_anno,
left_annotation = left_anno,
column_title = paste0(
gene_id, " -- ", gene_names[gene_id], "\n",
nrow(geno_mat), " individuals (Gulf: ", n_gulf, " | Atlantic: ", n_atl, ")  x  ",
ncol(geno_mat), " SNPs  |  ",
"Coding: ", sum(eff != "other" & eff != "intron"),
" (", paste(names(table(eff[eff != "other" & eff != "intron"])), collapse = ", "), ")",
"  |  Intron: ", sum(eff == "intron"),
"  |  Other: ", sum(eff == "other")
),
border  = TRUE,
rect_gp = gpar(col = "white", lwd = 0.3)
)
# -------------------------------------------------------------------------
# SAVE TO PDF
# -------------------------------------------------------------------------
# NEW
out_file   <- paste0(gene_id, "_ComplexHeatmap.pdf")
pdf_width  <- min(40, max(12, 8 + length(snp_cols) * 0.25))  # cap at 40 inches
pdf_height <- 14
# shrink column font for genes with many SNPs
col_fontsize <- ifelse(length(snp_cols) > 100, 4,
ifelse(length(snp_cols) > 50,  5, 6))
pdf(out_file, width = pdf_width, height = pdf_height)
draw(ht, merge_legend = TRUE,
heatmap_legend_side    = "right",
annotation_legend_side = "right")
dev.off()
cat("  Saved:", out_file, "(", pdf_width, "x", pdf_height, ")\n")
}
# =============================================================================
# step2_complexheatmap.R
# Author: Megha Prasad
# Date:   May 2026
#
# What this does:
# Makes publication-quality genotype heatmaps using ComplexHeatmap.
# Reads from the combined top50 stats table and combined geno CSV.
# Selects top 5 genes by SNP count and makes one PDF per gene.
#
# Run locally in RStudio (ComplexHeatmap not available on cluster).
#
# Inputs (all in ~/Desktop/Work/top5_results/):
#   top50_all_genes_Stats_Table.csv       - combined SNP info from step1
#   top50_all_genes_geno_allsnps.csv      - combined genotype matrix
#   seascape_individuals_metadata.csv
#
# Output:
#   <GENE>_ComplexHeatmap.pdf             - one per gene
# =============================================================================
library(ComplexHeatmap)
library(circlize)
library(grid)
# =============================================================================
# SETUP
# =============================================================================
setwd("~/Desktop/Work/top5_results")
cat("Loading combined stats table...\n")
all_stats <- read.csv("top50_all_genes_Stats_Table.csv", stringsAsFactors = FALSE)
cat("  Rows:", nrow(all_stats), "| Genes:", length(unique(all_stats$gene_id)), "\n")
cat("Loading combined geno matrix...\n")
all_geno <- read.csv("top50_all_genes_geno_allsnps.csv",
stringsAsFactors = FALSE, check.names = FALSE)
cat("  Dimensions:", nrow(all_geno), "individuals x", ncol(all_geno), "columns\n")
cat("Loading metadata...\n")
meta <- read.csv("seascape_individuals_metadata.csv", stringsAsFactors = FALSE)
# =============================================================================
# TOP 5 GENES — from pivot table (SUM of Any_outlier, descending)
# =============================================================================
top5_genes <- c("LOC111123434", "LOC111104812", "LOC111102475",
"LOC111103558", "LOC111122602")
cat("\nTop 5 genes:\n")
print(top5_genes)
# get gene display names from descriptions column
get_gene_name <- function(gid) {
rows <- all_stats[all_stats$gene_id == gid, ]
if ("descriptions" %in% colnames(rows) &&
!is.na(rows$descriptions[1]) && rows$descriptions[1] != "") {
return(as.character(rows$descriptions[1]))
}
return(gid)
}
gene_names <- setNames(sapply(top5_genes, get_gene_name), top5_genes)
# =============================================================================
# COLORS
# =============================================================================
geno_colors    <- colorRamp2(c(0, 1, 2), c("#92C5DE", "#F7F7F7", "#F4A582"))
outlier_colors <- c("Y" = "#E65100", "N" = "#F0F0F0")
effect_colors <- c(
"syn"               = "#4575B4",
"mis"               = "#D73027",
"splice+syn"        = "#00CD6C",
"mis+splice"        = "#FFC61E",
"stop_gain"         = "#AF58BA",
"stop_loss"         = "#F28522",
"start_loss"        = "#00C2C7",
"start_ret"         = "#FF6F91",
"stop_ret"          = "#845EC2",
"stop_gain+splice"  = "#D65DB1",
"stop_loss+splice"  = "#008B74",
"start_loss+splice" = "#B0A8B9",
"intron"            = "#A0B1BA",
"other"             = "white"
)
# =============================================================================
# EFFECT CLASSIFICATION
# =============================================================================
effect_lookup <- c(
"synonymous_variant"                        = "syn",
"missense_variant"                          = "mis",
"splice_region_variant&synonymous_variant"  = "splice+syn",
"missense_variant&splice_region_variant"    = "mis+splice",
"stop_gained"                               = "stop_gain",
"stop_lost"                                 = "stop_loss",
"start_lost"                                = "start_loss",
"start_retained_variant"                    = "start_ret",
"stop_retained_variant"                     = "stop_ret",
"stop_gained&splice_region_variant"         = "stop_gain+splice",
"stop_lost&splice_region_variant"           = "stop_loss+splice",
"start_lost&splice_region_variant"          = "start_loss+splice",
"intron_variant"                            = "intron"
)
classify_effect <- function(e) {
e <- as.character(e)
if (is.na(e) || e == "") return("other")
if (e == "5_prime_UTR_premature_start_codon_gain_variant") return("other")
if (e %in% names(effect_lookup)) return(effect_lookup[[e]])
return("other")
}
make_yn <- function(x) {
x <- as.character(x)
ifelse(x %in% c("TRUE", "Y", "Yes", "yes", "true"), "Y", "N")
}
# =============================================================================
# MAIN LOOP — one heatmap per gene
# =============================================================================
for (gene_id in top5_genes) {
cat("\n=== Processing", gene_id, "===\n")
# subset stats table to this gene
stats <- all_stats[all_stats$gene_id == gene_id, ]
cat("  SNPs in stats table:", nrow(stats), "\n")
# get Affx IDs for this gene
affx_ids <- stats$Affx_ID
# find which Affx IDs are columns in the geno matrix
# (check.names=FALSE means dashes are preserved)
snp_cols <- affx_ids[affx_ids %in% colnames(all_geno)]
cat("  SNPs found in geno matrix:", length(snp_cols), "/", length(affx_ids), "\n")
if (length(snp_cols) == 0) {
cat("  Skipping - no SNPs found in geno matrix\n")
next
}
# pull out just this gene's SNP columns + metadata columns
meta_cols <- c("clean_ID", "Pop_ID", "Mean_Annual_Temperature_C",
"Mean_Annual_Salinity_ppt")
geno <- all_geno[, c(meta_cols, snp_cols), drop = FALSE]
# -------------------------------------------------------------------------
# PREPARE GENOTYPE MATRIX
# -------------------------------------------------------------------------
# drop rows with missing metadata
geno <- geno[complete.cases(geno[, meta_cols]), ]
# order by Pop_ID (Gulf 1-13 on top, Atlantic 14-40 on bottom)
geno <- geno[order(geno$Pop_ID), ]
geno_mat <- as.matrix(geno[, snp_cols, drop = FALSE])
rownames(geno_mat) <- geno$clean_ID
n_gulf <- sum(geno$Pop_ID <= 13)
n_atl  <- sum(geno$Pop_ID >= 14)
cat("  Individuals:", nrow(geno), "(Gulf:", n_gulf, "| Atlantic:", n_atl, ")\n")
# -------------------------------------------------------------------------
# COLUMN LABELS — Affx ID (REF/ALT)
# -------------------------------------------------------------------------
stats_ordered <- stats[match(snp_cols, stats$Affx_ID), ]
col_labels    <- paste0(stats_ordered$Affx_ID, " (",
stats_ordered$REF, "/", stats_ordered$ALT, ")")
# -------------------------------------------------------------------------
# TOP ANNOTATIONS
# -------------------------------------------------------------------------
eff        <- sapply(stats_ordered$Effect, classify_effect)
eff_levels <- unique(eff)
eff_cols   <- effect_colors[eff_levels]
cat("  Effect types:", paste(names(table(eff)), collapse = ", "), "\n")
fst <- pmax(pmin(replace(stats_ordered$FST, is.na(stats_ordered$FST), 0), 1), 0)
outlier_col_names <- c("outflank_outlier", "pcadapt_outlier_qval",
"lfmm_global_hightemp_outlier", "lfmm_global_lowtemp_outlier",
"lfmm_atlantic_highsal_outlier", "lfmm_atlantic_lowsal_outlier",
"lfmm_gulf_highsal_outlier", "lfmm_gulf_lowsal_outlier")
outlier_display <- c("outflank", "pcadapt",
"lfmm_hitemp", "lfmm_lotemp",
"lfmm_atl_hisal", "lfmm_atl_losal",
"lfmm_gulf_hisal", "lfmm_gulf_losal")
outlier_list <- list()
for (i in seq_along(outlier_col_names)) {
col <- outlier_col_names[i]
outlier_list[[outlier_display[i]]] <- if (col %in% colnames(stats_ordered)) {
make_yn(stats_ordered[[col]])
} else {
rep("N", nrow(stats_ordered))
}
}
top_anno <- HeatmapAnnotation(
outflank        = outlier_list[["outflank"]],
pcadapt         = outlier_list[["pcadapt"]],
lfmm_hitemp     = outlier_list[["lfmm_hitemp"]],
lfmm_lotemp     = outlier_list[["lfmm_lotemp"]],
lfmm_atl_hisal  = outlier_list[["lfmm_atl_hisal"]],
lfmm_atl_losal  = outlier_list[["lfmm_atl_losal"]],
lfmm_gulf_hisal = outlier_list[["lfmm_gulf_hisal"]],
lfmm_gulf_losal = outlier_list[["lfmm_gulf_losal"]],
FST    = fst,
Effect = eff,
col = list(
outflank        = outlier_colors,
pcadapt         = outlier_colors,
lfmm_hitemp     = outlier_colors,
lfmm_lotemp     = outlier_colors,
lfmm_atl_hisal  = outlier_colors,
lfmm_atl_losal  = outlier_colors,
lfmm_gulf_hisal = outlier_colors,
lfmm_gulf_losal = outlier_colors,
FST    = colorRamp2(c(0, 0.5, 1), c("#F7FCF5", "#74C476", "#00441B")),
Effect = eff_cols
),
show_legend = c(TRUE, FALSE, FALSE, FALSE,
FALSE, FALSE, FALSE, FALSE,
TRUE, TRUE),
annotation_name_gp = gpar(fontsize = 9),
gap = unit(1, "mm")
)
# -------------------------------------------------------------------------
# LEFT ANNOTATIONS
# -------------------------------------------------------------------------
temp_range <- range(geno$Mean_Annual_Temperature_C, na.rm = TRUE)
sal_range  <- range(geno$Mean_Annual_Salinity_ppt,  na.rm = TRUE)
left_anno <- rowAnnotation(
Pop_ID = geno$Pop_ID,
Temp   = geno$Mean_Annual_Temperature_C,
Sal    = geno$Mean_Annual_Salinity_ppt,
col = list(
Pop_ID = colorRamp2(c(1, 20, 40),           c("#FDE725", "#21918C", "#440154")),
Temp   = colorRamp2(c(temp_range[1],
mean(temp_range),
temp_range[2]),         c("#2166AC", "#F7F7F7", "#B2182B")),
Sal    = colorRamp2(sal_range,               c("#E0F7FA", "#00695C"))
),
width = unit(c(0.6, 0.6, 0.6), "cm"),
annotation_name_gp = gpar(fontsize = 9),
annotation_legend_param = list(
Pop_ID = list(title = "Pop ID"),
Temp   = list(title = "Temp (C)"),
Sal    = list(title = "Sal (ppt)")
)
)
# -------------------------------------------------------------------------
# DRAW HEATMAP
# -------------------------------------------------------------------------
pop_group <- factor(ifelse(geno$Pop_ID <= 13, "Gulf", "Atlantic"),
levels = c("Gulf", "Atlantic"))
ht <- Heatmap(
geno_mat,
name = "Genotype",
col  = geno_colors,
heatmap_legend_param = list(
at = c(0, 1, 2), labels = c("Ref", "Het", "Alt")
),
cluster_rows    = FALSE,
cluster_columns = TRUE,   # let SNPs cluster naturally (Katie's request)
row_split       = pop_group,
row_gap         = unit(2, "mm"),
row_title_gp    = gpar(fontsize = 11, fontface = "bold"),
column_labels   = col_labels,
column_names_rot = 90,
column_names_gp = gpar(fontsize = 6),
show_row_names  = FALSE,
top_annotation  = top_anno,
left_annotation = left_anno,
column_title = paste0(
gene_id, " -- ", gene_names[gene_id], "\n",
nrow(geno_mat), " individuals (Gulf: ", n_gulf, " | Atlantic: ", n_atl, ")  x  ",
ncol(geno_mat), " SNPs  |  ",
"Coding: ", sum(eff != "other" & eff != "intron"),
" (", paste(names(table(eff[eff != "other" & eff != "intron"])), collapse = ", "), ")",
"  |  Intron: ", sum(eff == "intron"),
"  |  Other: ", sum(eff == "other")
),
border  = TRUE,
rect_gp = gpar(col = "white", lwd = 0.3)
)
# -------------------------------------------------------------------------
# SAVE TO PDF
# -------------------------------------------------------------------------
out_file   <- paste0(gene_id, "_ComplexHeatmap.pdf")
# scale width by SNP count but cap at 40 inches (PDF limit)
# for large genes (>100 SNPs) use smaller per-SNP multiplier
n_snps <- length(snp_cols)
if (n_snps <= 50) {
pdf_width <- max(14, 8 + n_snps * 0.25)
} else if (n_snps <= 150) {
pdf_width <- max(20, 8 + n_snps * 0.15)
} else {
pdf_width <- max(24, 8 + n_snps * 0.10)
}
pdf_width  <- min(pdf_width, 40)  # hard cap at 40 inches
pdf_height <- 14
pdf(out_file, width = pdf_width, height = pdf_height)
draw(ht, merge_legend = TRUE,
heatmap_legend_side    = "right",
annotation_legend_side = "right")
dev.off()
cat("  Saved:", out_file, "(", pdf_width, "x", pdf_height, ")\n")
}
cat("\nAll done!\n")
pwd
mv POP_08_PCA_files POP_08_PCA
quarto render POP_06_fastq2vcf_pipeline.qmd
quarto render POP_06_fastq2vcf_june2022_update.qmd
